# Server Configuration

# JWT Secret for authentication
JWT_SECRET=supersecret_change_me

# Google OAuth Credentials (Required)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# Encryption Keys (Required JSON)
# Example format: {"current": "v1", "keys": {"v1": "base64encodedkey"}}
# You can generate a random base64 string using: openssl rand -base64 32
ENCRYPTION_KEYS='{"current": "v1", "keys": {"v1": "change_me_to_base64_string"}}'

# =====================
# RAG Configuration
# =====================

# Ollama (local embeddings)
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Langfuse Observability (local)
# Note: Generate keys after first Langfuse startup at http://localhost:3080
LANGFUSE_HOST=http://localhost:3080
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here

# Document Storage
NOTES_DIR=/app/mkdn_files

# Vector Store
VECTOR_TABLE_NAME=document_chunk
VECTOR_DISTANCE_STRATEGY=cosine
